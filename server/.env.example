# ── Model (required) ─────────────────────────────────────────────────────────
# Google AI Studio free tier — no billing account needed.
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key

# Fallback chain, tried in order. Free Gemini allows ~20 requests/day per model,
# so one model alone runs dry. A 429 strikes a model off for the process; a 503
# just moves to the next.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# Hard deadline per model call, in ms. The Destination Agent is the slow one —
# measured at ~41s on gemini-3.6-flash — so 45s left no headroom and aborted mid-run.
# A blown deadline moves to the next model in the chain rather than failing.
LLM_TIMEOUT_MS=90000

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file. On a free host the filesystem is ephemeral, so run history resets
# on redeploy — see the note in storage/runs.ts.
DB_PATH=data/runs.db

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated browser origins allowed to call this API. Add the deployed
# frontend origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
