# ── Language model (required) ────────────────────────────────────────────────
# Google AI Studio free tier — no billing account needed.
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key

# Optional model overrides. Defaults shown.
GEMINI_SMART_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash-lite

# Hard deadline per model call, in ms. One bounded retry happens on top.
LLM_TIMEOUT_MS=45000

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB Atlas free tier (M0) works fine.
# For a deployed API, allow 0.0.0.0/0 in Atlas Network Access so the host can reach it.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/travel-agent

# ── Web search (optional) ────────────────────────────────────────────────────
# Free key at https://tavily.com — the Destination Agent falls back to the
# model's own knowledge when this is unset, so the app runs without it.
TAVILY_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
